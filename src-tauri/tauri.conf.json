{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bartleby",
  "version": "0.1.0-11",
  "identifier": "fr.bartleby.dit",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Bartleby",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "externalBin": [
      "binaries/bartleby-ffmpeg",
      "binaries/bartleby-mediainfo"
    ],
    "category": "Video",
    "shortDescription": "Multi-destination media offload with checksum verification and ASC MHL",
    "longDescription": "Bartleby copies camera cards and media to several destinations at once, re-reads every copy from disk to verify it (MD5, SHA-1, XXH64, XXH3, XXH128, C4), and writes checksum files, ASC MHL v2.0 histories and CSV / PDF / HTML reports. Built for DITs and data wranglers."
  }
}
